// Generato da build.sh: una configurazione IntelliSense per ogni plugin in src/
{
    "env": {
        "dpfIncludes": [
            "${workspaceFolder}/dep/dpf/distrho",
            "${workspaceFolder}/dep/dpf/dgl",
            "${workspaceFolder}/dep/dpf-widgets/generic",
            "${workspaceFolder}/dep/dpf-widgets/opengl",
            "${workspaceFolder}/dep/dpf-widgets/opengl/DearImGui",
            "${workspaceFolder}/common/ui"
        ]
    },
    "configurations": [
        {
            "name": "diffuser",
            "includePath": [ "${dpfIncludes}", "${workspaceFolder}/src/diffuser/plugin/source" ],
            "defines": [ "DGL_OPENGL=1", "HAVE_OPENGL=1" ],
            "compilerPath": "/usr/bin/clang++",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        },
        {
            "name": "lontananza",
            "includePath": [ "${dpfIncludes}", "${workspaceFolder}/src/lontananza/plugin/source" ],
            "defines": [ "DGL_OPENGL=1", "HAVE_OPENGL=1" ],
            "compilerPath": "/usr/bin/clang++",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        },
        {
            "name": "orbita",
            "includePath": [ "${dpfIncludes}", "${workspaceFolder}/src/orbita/plugin/source" ],
            "defines": [ "DGL_OPENGL=1", "HAVE_OPENGL=1" ],
            "compilerPath": "/usr/bin/clang++",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        },
        {
            "name": "test_basic",
            "includePath": [ "${dpfIncludes}", "${workspaceFolder}/src/test_basic/plugin/source" ],
            "defines": [ "DGL_OPENGL=1", "HAVE_OPENGL=1" ],
            "compilerPath": "/usr/bin/clang++",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}
